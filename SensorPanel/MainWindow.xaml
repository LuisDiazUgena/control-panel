<Window x:Class="SensorPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SensorPanel"
        Title="Sensor Panel" Width="1024" Height="600"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="#1E2027"
        UseLayoutRounding="True">
    <Window.ContextMenu>
        <ContextMenu x:Name="Menu" Opened="Menu_Opened">
            <MenuItem x:Name="MonitorMenu" Header="Monitor"/>
            <MenuItem x:Name="TopmostItem" Header="Siempre visible" IsCheckable="True" Click="Topmost_Click"/>
            <MenuItem x:Name="AutostartItem" Header="Iniciar con Windows" IsCheckable="True" Click="Autostart_Click"/>
            <Separator/>
            <MenuItem Header="Exportar lista de sensores…" Click="Dump_Click"/>
            <MenuItem Header="Abrir config.json" Click="OpenConfig_Click"/>
            <MenuItem Header="Recargar configuración" Click="Reload_Click"/>
            <Separator/>
            <MenuItem Header="Salir" Click="Exit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Viewbox Stretch="Uniform">
        <Canvas x:Name="Root" Width="1024" Height="600" ClipToBounds="True">
            <Canvas x:Name="Backdrop" Width="1024" Height="600"/>

            <!-- CPU -->
            <ContentControl Style="{StaticResource PanelFrame}" Canvas.Left="8" Canvas.Top="8">
                <Canvas>
                    <TextBlock x:Name="CpuTitle" Style="{StaticResource PanelTitle}" Text="CPU"/>
                    <Path x:Name="CpuIcon" Data="{StaticResource IconCpu}" Fill="{StaticResource Outline}" Stretch="Uniform"
                          Canvas.Left="36" Canvas.Top="70" Width="76" Height="76"/>
                    <Image x:Name="CpuImage" Canvas.Left="28" Canvas.Top="44" Width="92" Height="128" Visibility="Collapsed"/>
                    <TextBlock Style="{StaticResource Caption}" Canvas.Left="142" Canvas.Top="34" Text="CORE CLOCK"/>
                    <TextBlock x:Name="CpuClock" Style="{StaticResource Reading}" Canvas.Left="142" Canvas.Top="50" Text="--"/>
                    <local:Sparkline x:Name="CpuClockGraph" Canvas.Left="142" Canvas.Top="98" Width="160" Height="80" MinRange="4000"/>
                    <TextBlock Style="{StaticResource Caption}" Canvas.Left="320" Canvas.Top="34" Text="CORE VOLTAGE"/>
                    <TextBlock x:Name="CpuVoltage" Style="{StaticResource Reading}" Canvas.Left="320" Canvas.Top="50" Text="--"/>
                    <local:Sparkline x:Name="CpuVoltageGraph" Canvas.Left="320" Canvas.Top="98" Width="160" Height="80" MinRange="1.4"/>
                </Canvas>
            </ContentControl>

            <!-- GPU -->
            <ContentControl Style="{StaticResource PanelFrame}" Canvas.Left="8" Canvas.Top="204">
                <Canvas>
                    <TextBlock x:Name="GpuTitle" Style="{StaticResource PanelTitle}" Text="GPU"/>
                    <Path x:Name="GpuIcon" Data="{StaticResource IconGpu}" Fill="{StaticResource Outline}" Stretch="Uniform"
                          Canvas.Left="32" Canvas.Top="72" Width="84" Height="72"/>
                    <Image x:Name="GpuImage" Canvas.Left="28" Canvas.Top="44" Width="92" Height="128" Visibility="Collapsed"/>
                    <TextBlock Style="{StaticResource Caption}" Canvas.Left="142" Canvas.Top="34" Text="CORE CLOCK"/>
                    <TextBlock x:Name="GpuClock" Style="{StaticResource Reading}" FontSize="27" Canvas.Left="142" Canvas.Top="51" Text="--"/>
                    <local:Sparkline x:Name="GpuClockGraph" Canvas.Left="142" Canvas.Top="98" Width="128" Height="80" MinRange="1500"/>
                    <TextBlock Style="{StaticResource Caption}" Canvas.Left="286" Canvas.Top="34" Text="GPU MEM"/>
                    <TextBlock x:Name="GpuMemClock" Style="{StaticResource Reading}" FontSize="27" Canvas.Left="286" Canvas.Top="51" Text="--"/>
                    <local:Sparkline x:Name="GpuMemClockGraph" Canvas.Left="286" Canvas.Top="98" Width="128" Height="80" MinRange="5000"/>

                    <TextBlock Style="{StaticResource Caption}" Canvas.Left="428" Canvas.Top="30" Text="MEM"/>
                    <TextBlock x:Name="GpuMemTemp" Style="{StaticResource SmallReading}" Canvas.Left="428" Canvas.Top="45" Text="--"/>
                    <TextBlock Style="{StaticResource Caption}" Canvas.Left="428" Canvas.Top="82" Text="HOT"/>
                    <TextBlock x:Name="GpuHotSpot" Style="{StaticResource SmallReading}" Canvas.Left="428" Canvas.Top="97" Text="--"/>
                    <TextBlock x:Name="FpsCaption" Style="{StaticResource Caption}" Canvas.Left="428" Canvas.Top="134" Text="FPS"/>
                    <TextBlock x:Name="Fps" Style="{StaticResource SmallReading}" Canvas.Left="428" Canvas.Top="149" Text="0"/>
                </Canvas>
            </ContentControl>

            <!-- Drives -->
            <ContentControl Style="{StaticResource PanelFrame}" Canvas.Left="8" Canvas.Top="400">
                <Canvas>
                    <TextBlock Style="{StaticResource PanelTitle}" Text="DRIVES"/>
                    <Path Data="{StaticResource IconFloppy}" Fill="{StaticResource Outline}" Stretch="Uniform"
                          Canvas.Left="38" Canvas.Top="72" Width="72" Height="72"/>
                    <Canvas x:Name="DriveRows"/>
                </Canvas>
            </ContentControl>

            <!-- Tiles: 3 columns x 4 rows, 161x140 with 8 px gaps -->
            <local:Tile x:Name="CpuTempTile" Label="CPU TEMP" Icon="{StaticResource IconThermo}" Canvas.Left="516" Canvas.Top="8"/>
            <local:Tile x:Name="GpuTempTile" Label="GPU TEMP" Icon="{StaticResource IconThermo}" Canvas.Left="685" Canvas.Top="8"/>
            <local:Tile x:Name="LiquidTempTile" Label="LIQ TEMP" Icon="{StaticResource IconThermo}" Canvas.Left="854" Canvas.Top="8"/>
            <local:Tile x:Name="CpuLoadTile" Label="CPU %" Icon="{StaticResource IconGauge}" Canvas.Left="516" Canvas.Top="156"/>
            <local:Tile x:Name="GpuLoadTile" Label="GPU %" Icon="{StaticResource IconGauge}" Canvas.Left="685" Canvas.Top="156"/>
            <local:Tile x:Name="RamLoadTile" Label="RAM %" Icon="{StaticResource IconGauge}" Canvas.Left="854" Canvas.Top="156"/>
            <local:Tile x:Name="CpuPowerTile" Label="CPU W" Icon="{StaticResource IconBolt}" Canvas.Left="516" Canvas.Top="304"/>
            <local:Tile x:Name="GpuPowerTile" Label="GPU W" Icon="{StaticResource IconBolt}" Canvas.Left="685" Canvas.Top="304"/>
            <local:Tile x:Name="GpuTdpTile" Label="GPU TDP %" Icon="{StaticResource IconBolt}" Canvas.Left="854" Canvas.Top="304"/>
            <local:Tile x:Name="FanTile" Label="FAN RPM" Icon="{StaticResource IconFan}" Canvas.Left="854" Canvas.Top="452"/>

            <!-- Clock: fills the two free cells of the bottom row -->
            <Viewbox Canvas.Left="516" Canvas.Top="452" Width="330" Height="140" Stretch="Uniform">
                <StackPanel Margin="4,0">
                    <TextBlock x:Name="Clock" FontFamily="{StaticResource ValueFont}" FontSize="100" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMain}" Text="00:00" Margin="0,-16,0,-14"/>
                    <TextBlock x:Name="Date" FontFamily="{StaticResource ValueFont}" FontSize="26"
                               Foreground="{StaticResource TextMain}" Text="01/01/2026" Margin="6,0,0,0"/>
                </StackPanel>
            </Viewbox>

            <TextBlock x:Name="Status" Canvas.Left="150" Canvas.Top="582" FontSize="12" Foreground="#FFB0B0"
                       Visibility="Collapsed"/>
        </Canvas>
    </Viewbox>
</Window>
